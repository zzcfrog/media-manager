{
  "name": "media-manager",
  "productName": "映屿 · luminisle",
  "version": "1.0.24",
  "main": "main.js",
  "scripts": {
    "start": "ELECTRON_RUN_AS_NODE= electron .",
    "test": "node ../tests/desktop-runtime.cjs && node ../tests/desktop-model-paths.cjs && node ../tests/desktop-model-migration.cjs && node ../tests/desktop-model-apply.cjs",
    "build:icons": "python3 ../packaging/build_icons.py",
    "build:mac": "npm run build:icons && electron-builder --mac dmg zip --arm64"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "映屿 · luminisle — 私人影像与声音资料库",
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.zack.media-manager",
    "productName": "映屿 · luminisle",
    "asar": true,
    "files": [
      "main.js",
      "runtime.js",
      "model-paths.js",
      "model-migration.js",
      "preload.js",
      "package.json",
      "icon.icns",
      "dock-icon.png"
    ],
    "directories": {
      "output": "../dist",
      "buildResources": "."
    },
    "extraResources": [
      {
        "from": "../build/runtime/backend",
        "to": "backend"
      },
      {
        "from": "../build/tools",
        "to": "tools"
      },
      {
        "from": "resources/bin/darwin-arm64",
        "to": "bin/darwin-arm64"
      },
      {
        "from": "../docs/UPGRADE-AND-DATA.md",
        "to": "UPGRADE-AND-DATA.md"
      }
    ],
    "mac": {
      "electronLanguages": [
        "en",
        "en_GB",
        "zh_CN",
        "zh_TW"
      ],
      "category": "public.app-category.video",
      "minimumSystemVersion": "26.0",
      "icon": "icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "signIgnore": [
        "Contents/Resources/tools/exiftool/"
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "entitlements": "../packaging/backend-entitlements.plist",
      "entitlementsInherit": "../packaging/backend-entitlements.plist"
    },
    "artifactName": "Luminisle-${version}-${arch}.${ext}",
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 200,
          "type": "file"
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "electronDist": "node_modules/electron/dist"
  }
}
